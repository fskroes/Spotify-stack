node_modules/
dist/
artifacts/
*.log
.DS_Store
demo-repos/*/node_modules/
demo-repos/*/.build/
.tmp/

# secrets
.env
.env.*
.secret
*.swp

# private fleet overlay (targets kept local, not committed)
fleet/repos.local.yaml

# machine-drafted task proposals and their drafted-scope sidecars: a draft for a
# private target is private prose. Approved drafts an operator wants to keep are
# moved into tasks/ (or tasks/private/) by hand.
tasks/drafts/

# the correction log: drafted scope vs approved scope, one row per draft. Rows
# name targets and their path globs, so the file never lands in the public repo.
fleet/correction-log.jsonl

# Locally compiled prose for private fleet targets. Public knowledge/*.md stays trackable.
knowledge/private/

# live state of currently-running tasks: one file per process, deleted when the
# run appends its ledger line. Machine-local and worthless a second later.
fleet/inflight/

# per-run model-usage evidence written by local runs. Machine-local and may hold
# real transcript-derived usage; never commit it into the public repo.
fleet/evidence/

# local Claude Code session config (personal/machine-local; the fleet injects its
# own .claude/ into sandboxes from agent-config/ at run time)
.claude/
.gstack/

# working notes and conversation transcripts. Not docs: nothing here is a
# decision, a term, or a measurement, so none of it belongs in the public record.
conv/
